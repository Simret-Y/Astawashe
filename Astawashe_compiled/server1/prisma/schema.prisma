generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(cuid())
  email                String?         @unique
  phone                String?         @unique
  passwordHash         String
  role                 Role
  isActive             Boolean         @default(true)
  emailVerified        Boolean         @default(false)
  otpHash              String?
  otpExpiresAt         DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  auditLogs            AuditLog[]
  doctorProfile        Doctor?
  guardianProfile      Guardian?
  hospitalAdminProfile HospitalAdmin?
  sentMessages         Message[]
  sentNotifications    Notification[]
  patientProfile       PatientProfile?
  refreshTokens        RefreshToken[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PendingRegistration {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  role         Role
  fullName     String?
  payload      Json?
  otpHash      String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([phone])
}

model Hospital {
  id                 String                @id @default(cuid())
  name               String
  organizationType   String?
  licenseNumber      String?               @unique
  registrationNumber String?               @unique
  address            String?
  city               String?
  region             String?
  phone              String?
  email              String?
  website            String?
  description        String?
  imageUrl           String?
  status             HospitalStatus        @default(PENDING)
  adminId            String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  doctors            Doctor[]
  admin              HospitalAdmin?
  approvals          HospitalApproval[]
  documents          HospitalDocument[]
  patients           PatientHospitalLink[]
  patientProfiles    PatientProfile[]      @relation("PatientHospital")
  services           Service[]
  subscriptions      Subscription?

  @@index([status])
  @@index([adminId])
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String   @unique
  fullName   String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HospitalDocument {
  id           String   @id @default(cuid())
  hospitalId   String
  documentType String
  documentPath String
  uploadedAt   DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

model HospitalApproval {
  id             String         @id @default(cuid())
  hospitalId     String
  approverUserId String?
  action         ApprovalAction
  reason         String?
  previousStatus HospitalStatus
  newStatus      HospitalStatus
  createdAt      DateTime       @default(now())
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([approverUserId])
}

model Doctor {
  id                  String               @id @default(cuid())
  userId              String               @unique
  hospitalId          String
  name                String
  email               String?
  phone               String?
  licenseNumber       String?              @unique
  specialization      String?
  experience          String?
  bio                 String?
  imageUrl            String?
  status              DoctorStatus         @default(PENDING_HOSPITAL_APPROVAL)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cases               Case[]
  hospital            Hospital             @relation(fields: [hospitalId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvals           DoctorApproval[]
  medications         Medication[]
  medicationSchedules MedicationSchedule[]
  patientDoctorLinks  PatientDoctorLink[]
  assignedPatients    PatientProfile[]     @relation("PatientDoctor")
  prescriptions       Prescription[]
  voiceProfiles       VoiceProfile[]

  @@index([hospitalId])
  @@index([status])
}

model DoctorApproval {
  id             String         @id @default(cuid())
  doctorId       String
  approverUserId String?
  approvalLevel  String
  action         ApprovalAction
  reason         String?
  previousStatus DoctorStatus
  newStatus      DoctorStatus
  createdAt      DateTime       @default(now())
  doctor         Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([approvalLevel])
}

model PatientProfile {
  id                    String               @id @default(cuid())
  userId                String               @unique
  hospitalId            String
  doctorId              String
  fullName              String
  nickname              String?              @unique
  dob                   DateTime?
  gender                String?
  phone                 String?
  address               String?
  emergencyContact      String?
  emergencyContactPhone String?
  bloodGroup            String?
  height                Float?
  weight                Float?
  allergies             String?
  chronicConditions     String?
  medicalHistory        String?
  status                PatientStatus        @default(PENDING_DOCTOR_APPROVAL)
  reminderMode          NotificationChannel  @default(VOICE)
  language              String               @default("en")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  adherenceLogs         AdherenceLog[]
  cases                 Case[]
  doseLogs              DoseLog[]
  habits                Habit[]
  medications           Medication[]
  schedules             MedicationSchedule[]
  approvals             PatientApproval[]
  guardians             PatientGuardian[]
  assignedDoctor        Doctor               @relation("PatientDoctor", fields: [doctorId], references: [id])
  hospital              Hospital             @relation("PatientHospital", fields: [hospitalId], references: [id])
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions         Prescription[]
  reminders             Reminder[]
  voiceProfiles         VoiceProfile[]

  @@index([hospitalId])
  @@index([doctorId])
  @@index([status])
  @@index([nickname])
}

model PatientHospitalLink {
  id            String   @id @default(cuid())
  patientUserId String
  hospitalId    String
  linkedAt      DateTime @default(now())
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([patientUserId, hospitalId])
}

model PatientDoctorLink {
  id            String   @id @default(cuid())
  patientUserId String
  doctorId      String
  linkedAt      DateTime @default(now())
  doctor        Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientUserId, doctorId])
}

model PatientApproval {
  id             String         @id @default(cuid())
  patientId      String
  approverUserId String?
  approvalLevel  String
  action         ApprovalAction
  reason         String?
  previousStatus PatientStatus
  newStatus      PatientStatus
  createdAt      DateTime       @default(now())
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([approvalLevel])
}

model Medication {
  id            String               @id @default(cuid())
  patientId     String
  doctorId      String
  name          String
  genericName   String?
  dosage        String
  strength      Float?
  form          String?
  manufacturer  String?
  instructions  String?
  notes         String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  doctor        Doctor               @relation(fields: [doctorId], references: [id])
  user          PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  schedules     MedicationSchedule[]
  prescriptions Prescription[]

  @@index([patientId])
  @@index([doctorId])
}

model Prescription {
  id           String               @id @default(cuid())
  patientId    String
  doctorId     String
  medicationId String
  dose         String
  frequency    String
  startDate    DateTime
  endDate      DateTime?
  instructions String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  schedules    MedicationSchedule[]
  doctor       Doctor               @relation(fields: [doctorId], references: [id])
  medication   Medication           @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patient      PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
}

model MedicationSchedule {
  id             String         @id @default(cuid())
  patientId      String
  doctorId       String
  medicationId   String
  prescriptionId String?
  dosage         String
  time           String
  frequency      String
  specificDays   String?
  customInterval Int?
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  doseLogs       DoseLog[]
  doctor         Doctor         @relation(fields: [doctorId], references: [id])
  medication     Medication     @relation(fields: [medicationId], references: [id])
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription   Prescription?  @relation(fields: [prescriptionId], references: [id])
  reminders      Reminder[]

  @@index([patientId])
  @@index([doctorId])
  @@index([startDate])
  @@index([isActive])
}

model Reminder {
  id                 String              @id @default(cuid())
  patientId          String
  scheduleId         String?
  type               ReminderType
  title              String
  note               String?
  timesPerDay        Int?
  schedule           Json?
  startDate          DateTime?
  endDate            DateTime?
  isActive           Boolean             @default(true)
  channel            NotificationChannel @default(VOICE)
  voiceProfileId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  patient            PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationSchedule MedicationSchedule? @relation(fields: [scheduleId], references: [id])
  voiceProfile       VoiceProfile?       @relation(fields: [voiceProfileId], references: [id])
  reminderEvents     ReminderEvent[]

  @@index([patientId])
  @@index([scheduleId])
  @@index([isActive])
}

model ReminderEvent {
  id            String    @id @default(cuid())
  reminderId    String
  scheduledTime DateTime
  sentAt        DateTime?
  response      String?
  responseTime  DateTime?
  status        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reminder      Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@index([scheduledTime])
  @@index([status])
}

model DoseLog {
  id                 String               @id @default(cuid())
  patientId          String
  scheduleId         String
  scheduledDate      DateTime
  status             DoseStatus           @default(PENDING)
  confirmationMethod DoseConfirmationMethod?
  confirmedAt        DateTime?
  voiceResponse      String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  patient            PatientProfile       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  schedule           MedicationSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledDate])
  @@index([patientId])
  @@index([scheduleId])
  @@index([status])
}

model AdherenceLog {
  id             String         @id @default(cuid())
  patientId      String
  date           DateTime
  totalSchedules Int            @default(0)
  taken          Int            @default(0)
  missed         Int            @default(0)
  notTaken       Int            @default(0)
  adherenceRate  Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, date])
  @@index([patientId])
  @@index([date])
}

model VoiceProfile {
  id                 String         @id @default(cuid())
  doctorId           String
  patientId          String
  language           String         @default("en")
  preferredName      String?
  greetingAudioUrl   String?
  confirmationPrompt String?
  voiceType          String?
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  reminders          Reminder[]
  doctor             Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient            PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientId])
  @@index([patientId])
}

model Guardian {
  id           String            @id @default(cuid())
  userId       String            @unique
  fullName     String
  phone        String?
  email        String?
  relationship String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts       GuardianAlert[]
  patients     PatientGuardian[]
}

model PatientGuardian {
  id               String                   @id @default(cuid())
  patientId        String
  guardianId       String
  relationshipType GuardianRelationshipType
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  guardian         Guardian                 @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  patient          PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, guardianId])
  @@index([patientId])
  @@index([guardianId])
}

model GuardianAlert {
  id              String    @id @default(cuid())
  guardianId      String
  patientId       String
  patientNickname String?
  alertType       String
  message         String
  doseCount       Int?
  readAt          DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  guardian        Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId])
  @@index([readAt])
}

model Case {
  id          String         @id @default(cuid())
  patientId   String
  doctorId    String
  title       String
  description String
  status      CaseStatus     @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  doctor      Doctor         @relation(fields: [doctorId], references: [id])
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([patientId])
  @@index([doctorId])
}

model Message {
  id          String   @id @default(cuid())
  caseId      String?
  senderId    String
  recipientId String?
  messageType String   @default("TEXT")
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([senderId])
  @@index([recipientId])
}

model Notification {
  id               String    @id @default(cuid())
  userId           String
  title            String
  message          String
  notificationType String?
  relatedId        String?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

model Subscription {
  id               String              @id @default(cuid())
  hospitalId       String              @unique
  plan             SubscriptionPlan
  status           String              @default("ACTIVE")
  startDate        DateTime
  renewalDate      DateTime
  billingPeriodEnd DateTime?
  activePatients   Int                 @default(0)
  activeDoctors    Int                 @default(0)
  monthlyPrice     Float?
  yearlyPrice      Float?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  hospital         Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  usageRecords     SubscriptionUsage[]

  @@index([status])
}

model SubscriptionUsage {
  id             String       @id @default(cuid())
  subscriptionId String
  date           DateTime
  patientCount   Int
  doctorCount    Int
  remindersCount Int
  dosesConfirmed Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, date])
  @@index([subscriptionId])
}

model Habit {
  id               String         @id @default(cuid())
  patientId        String
  title            String
  frequencyPerWeek Int?
  reminderEnabled  Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  logs             HabitLog[]

  @@index([patientId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

model Service {
  id          String   @id @default(cuid())
  hospitalId  String
  name        String
  description String?
  department  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  recipientId       String
  channel           NotificationChannel
  messageType       String
  scheduledAt       DateTime
  sentAt            DateTime?
  deliveredAt       DateTime?
  responseAt        DateTime?
  status            String              @default("PENDING")
  response          String?
  provider          String              @default("DEMO")
  providerMessageId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([recipientId])
  @@index([channel])
  @@index([status])
}

model AuditLog {
  id               String   @id @default(cuid())
  actor            String?
  action           String
  entityType       String
  entityId         String?
  metadata         Json?
  deduplicationKey String?  @unique
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [actor], references: [id])

  @@index([actor])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  SYSTEM_ADMIN
  HEALTHCARE_WORKER
  GUARDIAN
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ReminderType {
  MEDICATION
  HABIT
}

enum HospitalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DoctorStatus {
  PENDING_HOSPITAL_APPROVAL
  HOSPITAL_APPROVED
  PENDING_SYSTEM_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum PatientStatus {
  PENDING_DOCTOR_APPROVAL
  DOCTOR_APPROVED
  PENDING_SYSTEM_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_MORE_INFO
  SUSPEND
  REACTIVATE
}

enum DoseStatus {
  PENDING
  TAKEN
  MISSED
  NOT_TAKEN
  SNOOZED
  SKIPPED
}

enum NotificationChannel {
  VOICE
  SMS
  USSD
  PUSH
  EMAIL
}

enum DoseConfirmationMethod {
  APP
  VOICE
  SMS
  USSD
}

enum GuardianRelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  CAREGIVER
  OTHER
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}
